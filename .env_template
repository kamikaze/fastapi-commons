LOGGING_LEVEL=DEBUG

# Read by python3_commons.conf.OIDCSettings, which the application passes to fastapi_commons.oidc_lifespan
OIDC_AUTHORITY_URL=https://oidc.provider.com/realms/example
#OIDC_AUDIENCE=api://example
#OIDC_ISSUER=https://oidc.provider.com/realms/example
#OIDC_LEEWAY=0
#OIDC_CLIENT_ID=12345-54321
#OIDC_SCOPE=openid,profile,email

# Read by the OpenTelemetry SDK (fastapi-commons[otel])
#OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
#OTEL_SERVICE_NAME=example
